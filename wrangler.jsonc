// Bandezar – INSTALACJA NA KONCIE ZESPOŁU (opis: dokumentacja/INSTALACJA-ZESPOLU.md).
// Zespół, który kupił Bandezara, instaluje go przyciskiem „Deploy to Cloudflare” na swoim darmowym koncie Cloudflare.
// Cloudflare sam zakłada bazę D1 i schowek R2 (po nazwach niżej), tabele zakłada serwer przy pierwszym otwarciu.
// TRYB=zespol: jeden zespół; pierwsza osoba wpisuje kod licencji i zostaje liderem; koledzy wchodzą linkami zaproszeń (bez poczty).
// Ten sam kod co wersja bandezar-app (worker-app.js, serwer/baza.mjs).
{
  "name": "bandezar",
  "main": "worker-app.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "app/dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "bandezar" }],
  "r2_buckets": [{ "binding": "PLIKI", "bucket_name": "bandezar-pliki" }],
  "durable_objects": { "bindings": [{ "name": "ZESPOL", "class_name": "Zespol" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Zespol"] }],
  "vars": { "TRYB": "zespol", "SEND_DOMAINS": "", "REPLY_DOMAINS": "" },
  "previews": { "vars": { "TRYB": "zespol", "SEND_DOMAINS": "", "REPLY_DOMAINS": "" } }
}
